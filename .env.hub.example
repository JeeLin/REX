# Environment variables for REX Hub
# Copy this file to .env and fill in the actual values.
# Loaded at process start via dotenvy (supervisor passes the env to the worker).
# Every runtime variable below is read by the code — verified with:
#   grep -rhoE 'env::var\("[A-Z_0-9]+"' crates --include='*.rs'

# Hub HTTP server
REX_PORT=3000

# Data directory (for SQLite, TLS certs, agent binaries, etc.)
REX_DATA_DIR=/app/data

# Static assets directory — dev only. Production binary embeds dist via
# `embedded-static` feature; this variable is only read when the feature is off.
# REX_STATIC_DIR=./dist

# Worker process (set automatically by supervisor when spawning worker)
# REX_WORKER=1

# ═══ TLS 配置（二选一，都不设置则为 HTTP）══
# Self-signed: Hub 首次启动自动生成 cert+key 到 {REX_DATA_DIR}/tls/，无需提供任何证书文件
# （浏览器会弹证书警告；适合内网 / 测试环境；过期或损坏时自动重新生成）
# REX_TLS_SELF_SIGNED=true
# Manual PEM pair: startup aborts if cert expired / key mismatch / path unreadable
# REX_TLS_CERT=/app/data/certs/hub.crt
# REX_TLS_KEY=/app/data/certs/hub.key

# Agent binary search directories — Hub serves these for agent download/self-update.
# 默认搜索顺序：REX_AGENT_BINARIES_DIR → {data-dir}/agent-binaries → /app/agent-binaries → /usr/local/lib/rex/agents → ~/.rex/agents
# REX_AGENT_BINARIES_DIR=

# ═══ 自动更新（Hub 端）══
# GitHub 更新源
REX_UPDATE_GITHUB_OWNER=JeeLin
REX_UPDATE_GITHUB_REPO=REX
# 存在时标记有待应用的更新（由更新检测器设置）
# REX_UPDATE_PENDING=
