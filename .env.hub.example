# REX Hub 环境变量模板
# 复制本文件为 .env 并填入实际值。
# 进程启动时经 dotenvy 加载（supervisor 会把环境传递给 worker）。
# 下列运行时变量均在代码中实际读取，已用以下命令核对：
#   grep -rhoE 'env::var\("[A-Z_0-9]+"' crates --include='*.rs'

# Hub HTTP 服务
REX_PORT=3000

# 数据目录（SQLite、TLS 证书、Agent 二进制等）
REX_DATA_DIR=/app/data

# 静态资源目录 — 仅开发模式。生产二进制通过 `embedded-static` feature
# 将 dist 编译进二进制，该变量仅在未启用该 feature 时生效。
# REX_STATIC_DIR=./dist

# Worker 进程标识（supervisor 拉起 worker 时自动设置，不要手动设置）
# REX_WORKER=1

# ═══ TLS 配置（二选一，都不设置则为 HTTP）══
# 自签名：Hub 首次启动自动生成 cert+key 到 {REX_DATA_DIR}/tls/，无需提供任何证书文件
# （浏览器会弹证书警告；适合内网 / 测试环境；过期或损坏时自动重新生成）
# REX_TLS_SELF_SIGNED=true
# 手动 PEM：证书过期 / 私钥不匹配 / 路径不可读时拒绝启动
# REX_TLS_CERT=/app/data/certs/hub.crt
# REX_TLS_KEY=/app/data/certs/hub.key

# Agent 二进制搜索目录 — Hub 用于 Agent 下载 / 自更新时查找二进制
# 默认搜索顺序：REX_AGENT_BINARIES_DIR → {data-dir}/agent-binaries → /app/agent-binaries → /usr/local/lib/rex/agents → ~/.rex/agents
# REX_AGENT_BINARIES_DIR=

# ═══ 自动更新（Hub 端）══
# GitHub 更新源
REX_UPDATE_GITHUB_OWNER=JeeLin
REX_UPDATE_GITHUB_REPO=REX
# 存在时标记有待应用的更新（由更新检测器设置）
# REX_UPDATE_PENDING=
