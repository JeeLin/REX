# Environment variables for REX Agent
# Copy this file to .env and fill in the actual values.
# Loaded at process start via dotenvy (supervisor passes the env to the worker).
# Every runtime variable below is read by the code — verified with:
#   grep -rhoE 'env::var\("[A-Z_0-9]+"' crates --include='*.rs'

# Hub connection
REX_HUB_URL=https://your-hub.com
REX_AGENT_TOKEN=<环境注册令牌>

# Agent identity
REX_AGENT_NAME=agent
REX_HEARTBEAT_INTERVAL=30

# Agent HTTP control port (for local API access)
REX_AGENT_HTTP_PORT=3000

# Directory where the agent stages/swaps updated binaries
REX_AGENT_BINARIES_DIR=/app/data/agent-binaries

# TLS 信任设置（仅Agent需要）
# Hub 使用自签名证书时设置此项（跳过 TLS 证书验证）
# REX_TLS_INSECURE=true
# 自定义 CA 证书路径（PEM），加入 Agent 连 Hub 的 TLS 信任锚（与系统根合并）
# REX_CA_CERT=/app/data/certs/hub.crt

# ═══ 自动更新（Agent 端）══
# 存在时启用自动更新
# REX_AUTO_UPDATE=

# ═══ 共享变量（Hub 和 Agent 均使用）══
# 数据目录（同上，Hub 也会读取）
# REX_DATA_DIR=/app/data
# 日志级别（由 tracing 读取，不经过 dotenvy 的变量，但可在这里设置为示例）
# RUST_LOG=info
# 工作进程标记（同上，Hub 也会设置）
# REX_WORKER=1

# ═══ 仅用于构建 / CI （不在运行时读取）══
# GITHUB_SHA=… # release workflow stamps the binary version
# HOST=… # rex-sip build.rs linker selection