# Environment variables for REX Hub / REX Agent
# Copy this file to .env and fill in the actual values.
# Loaded at process start via dotenvy (supervisor passes the env to the worker).
# Every runtime variable below is read by the code — verified with:
#   grep -rhoE 'env::var\("[A-Z_0-9]+"' crates --include='*.rs'

# ─────────────── Hub ───────────────
# HTTP listen port (default: 3000)
REX_PORT=3000
# Data directory: SQLite, TLS certs, agent binaries, .master-key (default: ./data)
REX_DATA_DIR=./data
# Frontend static assets directory (default: embedded in the binary)
# REX_STATIC_DIR=./dist
# Set automatically by the supervisor when spawning the worker — do not set manually
# REX_WORKER=1

# TLS mode — pick at most one; none set = plain HTTP
# Self-signed (dev/test; browsers will warn)
# REX_TLS_SELF_SIGNED=true
# Manual certificates (production; PEM paths)
# REX_TLS_CERT=/path/to/fullchain.pem
# REX_TLS_KEY=/path/to/privkey.pem
# ACME / Let's Encrypt (production; domain must point at this server)
# REX_ACME_DOMAIN=hub.example.com
# REX_ACME_EMAIL=admin@example.com
# REX_ACME_STAGING=true

# Auto update (hub + agent)
# REX_AUTO_UPDATE=true
# REX_UPDATE_GITHUB_OWNER=JeeLin
# REX_UPDATE_GITHUB_REPO=REX
# Set by the updater itself — do not set manually
# REX_UPDATE_PENDING=1

# Logging — read by tracing (EnvFilter::from_default_env)
RUST_LOG=info

# ─────────────── Agent ───────────────
# Required: Hub address and enrollment token (from the Hub environment detail page)
# REX_HUB_URL=https://hub.example.com
# REX_AGENT_TOKEN=your-token-here
# REX_AGENT_NAME=agent
# Heartbeat interval in seconds (default: 30)
# REX_HEARTBEAT_INTERVAL=30
# Local HTTP control port of the agent (default: 3000)
# REX_AGENT_HTTP_PORT=3000
# Directory where the agent stages/swaps updated binaries
# REX_AGENT_BINARIES_DIR=./bin
# Skip TLS certificate verification of the Hub (intranet testing only)
# REX_TLS_INSECURE=true

# ─────────────── Build / CI only (not read at runtime) ───────────────
# GITHUB_SHA=…            # release workflow stamps the binary version
# HOST=…                  # rex-sip build.rs linker selection
